<Window x:Class="OpenATLAS.Workbench.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" Height="520"
        MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource PanelBackgroundBrush}"
        Foreground="{StaticResource ForegroundPrimaryBrush}"
        FontFamily="{StaticResource SystemFontFamily}">
    <!-- Plain text window used for Help > Import File Format and Help > About -->
    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Heading" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ForegroundHighlightBrush}" Margin="0,0,0,12" />

        <Border Grid.Row="1"
                Background="{StaticResource CanvasBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Padding="12,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="Body"
                           FontFamily="{StaticResource TelemetryNumberFontFamily}"
                           FontSize="11"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <Button Grid.Row="2"
                Content="CLOSE"
                Style="{StaticResource TracksideButton}"
                HorizontalAlignment="Right"
                IsCancel="True"
                IsDefault="True"
                Margin="0,16,0,0" />
    </Grid>
</Window>
