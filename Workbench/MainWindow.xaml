<Window x:Class="OpenATLAS.Workbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OpenATLAS.Workbench.ViewModels"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="OpenATLAS - Trackside Telemetry &amp; Delta Analysis Workbench"
        Width="1366" Height="860"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBackgroundBrush}"
        Foreground="{StaticResource ForegroundPrimaryBrush}"
        FontFamily="{StaticResource SystemFontFamily}">

    <Window.Resources>
        <!-- Dynamic Delta Color Style based on whether driver is ahead or behind baseline -->
        <Style x:Key="DynamicDeltaStyle" TargetType="TextBlock" BasedOn="{StaticResource DeltaReadoutText}">
            <Setter Property="Foreground" Value="{StaticResource DeltaAheadBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAheadOfReference}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DeltaBehindBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Speed Delta Color Style -->
        <Style x:Key="SpeedDeltaStyle" TargetType="TextBlock" BasedOn="{StaticResource TelemetryValueText}">
            <Setter Property="Foreground" Value="{StaticResource ForegroundHighlightBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAheadOfReference}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DeltaAheadBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAheadOfReference}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DeltaBehindBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.CommandBindings>
        <!-- File > Import Lap (Ctrl+O) -->
        <CommandBinding Command="ApplicationCommands.Open" Executed="OnImportLap" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding StartRacer1Command}" />
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding StopRacer1Command}" />
        <KeyBinding Key="F6" Command="{Binding PauseSimulationCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding ResetLapCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Menu Bar (File / Session / View / Help) -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Brand, Racer 1 Controls & Status Badge -->
            <RowDefinition Height="46" />
            <!-- Row 2: Racer Selection Bar (wraps on narrow windows) -->
            <RowDefinition Height="Auto" />
            <!-- Row 3: Main Work Area (Trace Panes + Telemetry Sidebar) -->
            <RowDefinition Height="*" />
            <!-- Row 4: Bottom Engineering Status Bar -->
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: MENU BAR                                                           -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0"
                Background="{StaticResource CanvasBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,0">
            <Menu>
                <MenuItem Header="_File">
                    <MenuItem Header="_Import Lap from CSV..." Command="ApplicationCommands.Open" />
                    <MenuItem Header="Open _My Laps Folder" Click="OnOpenMyLapsFolder" />
                    <Separator />
                    <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="OnExit" />
                </MenuItem>
                <MenuItem Header="_Session">
                    <MenuItem Header="_Start Racer 1" InputGestureText="F5" Command="{Binding StartRacer1Command}" />
                    <MenuItem Header="_Pause / Resume" InputGestureText="F6" Command="{Binding PauseSimulationCommand}" />
                    <MenuItem Header="S_top" InputGestureText="Shift+F5" Command="{Binding StopRacer1Command}" />
                    <MenuItem Header="_Reset Lap" InputGestureText="Ctrl+R" Command="{Binding ResetLapCommand}" />
                    <Separator />
                    <MenuItem Header="Record Live AC Laps to My Laps"
                              IsCheckable="True"
                              IsChecked="{Binding IsRecordingLaps, Mode=TwoWay}" />
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="_Track Map"
                              IsCheckable="True"
                              IsChecked="{Binding IsTrackMapVisible, Mode=TwoWay}" />
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="Import File _Format..." Click="OnShowImportFormat" />
                    <MenuItem Header="_About OpenATLAS" Click="OnAbout" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 1: BRAND, RACER 1 CONTROLS & STATUS BADGE                             -->
        <!-- ========================================================================= -->
        <Border Grid.Row="1"
                Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- Brand & Workbench Name -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Spacer -->
                    <ColumnDefinition Width="*" />
                    <!-- Racer 1 Controls & Status Badge -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="OPENATLAS"
                               FontFamily="{StaticResource SystemFontFamily}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource LiveTraceBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text=" | TELEMETRY WORKBENCH"
                               FontFamily="{StaticResource SystemFontFamily}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ForegroundMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0" />
                </StackPanel>

                <!-- Racer 1 controls: act on the source chosen in the selection bar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="START"
                            Style="{StaticResource TracksidePrimaryButton}"
                            Command="{Binding StartRacer1Command}"
                            ToolTip="Start Racer 1 from the selected source (F5)"
                            Margin="0,0,6,0" />

                    <!-- Pause / Resume (simulation and saved lap replay) -->
                    <Button Command="{Binding PauseSimulationCommand}"
                            ToolTip="Pause or resume a simulation or saved lap replay (F6)"
                            Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TracksideButton}">
                                <Setter Property="Content" Value="PAUSE" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSimulationPaused}" Value="True">
                                        <Setter Property="Content" Value="RESUME" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="STOP"
                            Style="{StaticResource TracksideButton}"
                            Command="{Binding StopRacer1Command}"
                            ToolTip="Stop Racer 1 (Shift+F5)"
                            Margin="0,0,6,0" />

                    <Button Content="RESET LAP"
                            Style="{StaticResource TracksideButton}"
                            Command="{Binding ResetLapCommand}"
                            ToolTip="Clear the live traces, deltas and pins (Ctrl+R)"
                            Margin="0,0,6,0" />

                    <!-- Saves every complete live AC lap to My Laps while on -->
                    <Button Command="{Binding ToggleRecordingCommand}"
                            ToolTip="Save every complete live AC lap to My Laps"
                            Margin="0,0,12,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TracksideButton}">
                                <Setter Property="Content" Value="REC OFF" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecordingLaps}" Value="True">
                                        <Setter Property="Content" Value="REC ON" />
                                        <Setter Property="Foreground" Value="{StaticResource BrakeBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BrakeBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Active Mode Badge -->
                    <Border Background="{StaticResource CanvasBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0"
                            Padding="10,4"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConnectionStatus}"
                                   FontFamily="{StaticResource TelemetryNumberFontFamily}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource StatusStandbyBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 2: RACER SELECTION (Racer 1 = compared lap, Racer 2 = reference)      -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,0">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- RACER 1 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,24,6">
                    <TextBlock Text="RACER 1"
                               Style="{StaticResource TelemetryLabelText}"
                               Foreground="{StaticResource LiveTraceBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <TextBlock Text="SOURCE"
                               Style="{StaticResource TelemetryLabelText}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox Style="{StaticResource TracksideComboBox}"
                              Width="110"
                              Foreground="{StaticResource LiveTraceBrush}"
                              ItemsSource="{Binding Racer1Sources}"
                              SelectedItem="{Binding SelectedRacer1Source}"
                              IsEnabled="{Binding CanChangeReference}"
                              ToolTip="Where Racer 1's lap comes from: live Assetto Corsa, the built-in simulation, or one of your saved laps" />

                    <!-- Saved lap picker, only for the SAVED LAP source -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSavedLapSource}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="LAP"
                                   Style="{StaticResource TelemetryLabelText}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,6,0" />
                        <ComboBox Style="{StaticResource TracksideComboBox}"
                                  Width="210"
                                  Foreground="{StaticResource LiveTraceBrush}"
                                  ItemsSource="{Binding AvailableSavedLaps}"
                                  SelectedItem="{Binding SelectedSavedLap}"
                                  IsEnabled="{Binding CanChangeReference}"
                                  ToolTip="Your saved laps for the selected Grand Prix (File > Import Lap, or REC while driving)" />
                    </StackPanel>
                </StackPanel>

                <!-- RACER 2 (reference) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                    <TextBlock Text="RACER 2"
                               Style="{StaticResource TelemetryLabelText}"
                               Foreground="{StaticResource ReferenceTraceBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <TextBlock Text="YEAR"
                               Style="{StaticResource TelemetryLabelText}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox Style="{StaticResource TracksideComboBox}"
                              Width="80"
                              ItemsSource="{Binding AvailableYears}"
                              SelectedItem="{Binding SelectedYear}"
                              IsEnabled="{Binding CanChangeReference}"
                              ToolTip="Championship year, or My Laps for your own saved laps" />

                    <TextBlock Text="GRAND PRIX"
                               Style="{StaticResource TelemetryLabelText}"
                               VerticalAlignment="Center"
                               Margin="12,0,6,0" />
                    <ComboBox Style="{StaticResource TracksideComboBox}"
                              Width="210"
                              ItemsSource="{Binding AvailableTracks}"
                              SelectedItem="{Binding SelectedTrack}"
                              IsEnabled="{Binding CanChangeReference}"
                              ToolTip="Grand Prix (also filters Racer 1's saved laps)" />

                    <TextBlock Text="DRIVER"
                               Style="{StaticResource TelemetryLabelText}"
                               VerticalAlignment="Center"
                               Margin="12,0,6,0" />
                    <ComboBox Style="{StaticResource TracksideComboBox}"
                              Width="140"
                              Foreground="{StaticResource ReferenceTraceBrush}"
                              ItemsSource="{Binding AvailableDrivers}"
                              SelectedItem="{Binding SelectedDriver}"
                              IsEnabled="{Binding CanChangeReference}"
                              ToolTip="Driver's fastest qualifying lap, or one of your saved laps" />

                    <TextBlock Text="LAP"
                               Style="{StaticResource TelemetryLabelText}"
                               VerticalAlignment="Center"
                               Margin="12,0,6,0" />
                    <TextBlock Text="{Binding ReferenceLapTimeString}"
                               FontFamily="{StaticResource TelemetryNumberFontFamily}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource ForegroundHighlightBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 3: MAIN TRACE WORKSPACE & TELEMETRY SIDEBAR                           -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- Column 0: 3 Synchronized Plot Trace Panes -->
                <ColumnDefinition Width="*" />
                <!-- Column 1: Trackside HUD / Telemetry Channels Sidebar -->
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <!-- ===================================================================== -->
            <!-- LEFT AREA: THREE SYNCHRONIZED TRACE PANES (Task 4.2 ScottPlot) -->
            <!-- ===================================================================== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <!-- Pane 1: Speed Trace (km/h) -->
                    <RowDefinition Height="3*" />
                    <!-- Pane 2: Pedal Inputs Trace (%) -->
                    <RowDefinition Height="2*" />
                    <!-- Pane 3: Delta Time Trace (s) -->
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <!-- PANE 1: SPEED TRACE CONTAINER -->
                <Border Grid.Row="0"
                        Style="{StaticResource TracksidePanelBorder}"
                        Margin="8,8,4,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Pane 1 Header & Legend -->
                        <Border Grid.Row="0" Style="{StaticResource TracksideHeaderBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="SPEED TRACE (km/h vs Distance)"
                                           Style="{StaticResource TelemetryLabelText}"
                                           Foreground="{StaticResource ForegroundHighlightBrush}" />

                                <!-- Distance cursor readout (empty until the mouse is over a plot) -->
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource TelemetryNumberFontFamily}"
                                           FontSize="11"
                                           FontWeight="SemiBold">
                                    <Run Text="{Binding Cursor.DistanceText, Mode=OneWay}" Foreground="{StaticResource ForegroundHighlightBrush}" />
                                    <Run Text="   " /><Run Text="{Binding Cursor.LiveSpeedText, Mode=OneWay}" Foreground="{StaticResource LiveTraceBrush}" />
                                    <Run Text="   " /><Run Text="{Binding Cursor.RefSpeedText, Mode=OneWay}" Foreground="{StaticResource ReferenceTraceBrush}" />
                                </TextBlock>

                                <!-- Channel Legends -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <!-- Live Trace Legend -->
                                    <Rectangle Width="10" Height="10" Fill="{StaticResource LiveTraceBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="LIVE VEHICLE" Style="{StaticResource TelemetryLabelText}" VerticalAlignment="Center" Margin="0,0,14,0" />

                                    <!-- Reference Trace Legend -->
                                    <Rectangle Width="10" Height="10" Fill="{StaticResource ReferenceTraceBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding ReferenceLabel}" Style="{StaticResource TelemetryLabelText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Pane 1 Plot Container (ScottPlot WpfPlot) -->
                        <Border Grid.Row="1"
                                x:Name="SpeedPlotHost"
                                Background="{StaticResource CanvasBackgroundBrush}"
                                SnapsToDevicePixels="True">
                            <sp:WpfPlot x:Name="SpeedPlot" />
                        </Border>
                    </Grid>
                </Border>

                <!-- PANE 2: PEDAL INPUTS TRACE CONTAINER -->
                <Border Grid.Row="1"
                        Style="{StaticResource TracksidePanelBorder}"
                        Margin="8,4,4,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Pane 2 Header & Legend -->
                        <Border Grid.Row="0" Style="{StaticResource TracksideHeaderBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="PEDAL INPUTS (% vs Distance)"
                                           Style="{StaticResource TelemetryLabelText}"
                                           Foreground="{StaticResource ForegroundHighlightBrush}" />

                                <!-- Distance cursor readout (empty until the mouse is over a plot) -->
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource TelemetryNumberFontFamily}"
                                           FontSize="11"
                                           FontWeight="SemiBold">
                                    <Run Text="{Binding Cursor.DistanceText, Mode=OneWay}" Foreground="{StaticResource ForegroundHighlightBrush}" />
                                    <Run Text="   " /><Run Text="{Binding Cursor.LivePedalText, Mode=OneWay}" Foreground="{StaticResource LiveTraceBrush}" />
                                    <Run Text="   " /><Run Text="{Binding Cursor.RefPedalText, Mode=OneWay}" Foreground="{StaticResource ReferenceTraceBrush}" />
                                </TextBlock>

                                <!-- Channel Legends -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Rectangle Width="10" Height="10" Fill="{StaticResource ThrottleBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="THROTTLE" Style="{StaticResource TelemetryLabelText}" VerticalAlignment="Center" Margin="0,0,14,0" />

                                    <Rectangle Width="10" Height="10" Fill="{StaticResource BrakeBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="BRAKE" Style="{StaticResource TelemetryLabelText}" VerticalAlignment="Center" Margin="0,0,14,0" />

                                    <Rectangle Width="10" Height="10" Fill="{StaticResource ReferenceTraceBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="REF INPUTS" Style="{StaticResource TelemetryLabelText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Pane 2 Plot Container (ScottPlot WpfPlot) -->
                        <Border Grid.Row="1"
                                x:Name="PedalPlotHost"
                                Background="{StaticResource CanvasBackgroundBrush}"
                                SnapsToDevicePixels="True">
                            <sp:WpfPlot x:Name="PedalPlot" />
                        </Border>
                    </Grid>
                </Border>

                <!-- PANE 3: DELTA TIME TRACE CONTAINER -->
                <Border Grid.Row="2"
                        Style="{StaticResource TracksidePanelBorder}"
                        Margin="8,4,4,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Pane 3 Header & Legend -->
                        <Border Grid.Row="0" Style="{StaticResource TracksideHeaderBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="DELTA TIME (Seconds vs Distance)"
                                           Style="{StaticResource TelemetryLabelText}"
                                           Foreground="{StaticResource ForegroundHighlightBrush}" />

                                <!-- Distance cursor readout (empty until the mouse is over a plot) -->
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource TelemetryNumberFontFamily}"
                                           FontSize="11"
                                           FontWeight="SemiBold">
                                    <Run Text="{Binding Cursor.DistanceText, Mode=OneWay}" Foreground="{StaticResource ForegroundHighlightBrush}" />
                                    <Run Text="   " /><Run Text="{Binding Cursor.DeltaText, Mode=OneWay}" Foreground="{StaticResource LiveTraceBrush}" />
                                </TextBlock>

                                <!-- Channel Legends -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Rectangle Width="10" Height="10" Fill="{StaticResource DeltaAheadBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="AHEAD (+)" Style="{StaticResource TelemetryLabelText}" VerticalAlignment="Center" Margin="0,0,14,0" />

                                    <Rectangle Width="10" Height="10" Fill="{StaticResource DeltaBehindBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="BEHIND (-)" Style="{StaticResource TelemetryLabelText}" VerticalAlignment="Center" Margin="0,0,14,0" />

                                    <Line X1="0" Y1="5" X2="12" Y2="5" Stroke="{StaticResource ForegroundMutedBrush}" StrokeDashArray="2,2" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="ZERO DELTA" Style="{StaticResource TelemetryLabelText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Pane 3 Plot Container (ScottPlot WpfPlot) -->
                        <Border Grid.Row="1"
                                x:Name="DeltaPlotHost"
                                Background="{StaticResource CanvasBackgroundBrush}"
                                SnapsToDevicePixels="True">
                            <sp:WpfPlot x:Name="DeltaPlot" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================================================================== -->
            <!-- RIGHT AREA: TRACKSIDE HUD & TELEMETRY CHANNELS SIDEBAR                -->
            <!-- ===================================================================== -->
            <Border Grid.Column="1"
                    Style="{StaticResource TracksidePanelBorder}"
                    Margin="4,8,8,8">
                <!-- Scrolls when the window is too short to show every section -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Section 1: Live Delta Readout -->
                        <RowDefinition Height="Auto" />
                        <!-- Section 2: Real-time Channel Numerics -->
                        <RowDefinition Height="Auto" />
                        <!-- Section 3: Driver Input Gauges -->
                        <RowDefinition Height="Auto" />
                        <!-- Section 4: Sector Timing & Session Metrics -->
                        <RowDefinition Height="Auto" />
                        <!-- Section 5: Track Map -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ============================================================= -->
                    <!-- SECTION 1: LIVE TIME DELTA READOUT (Head-Up Display)           -->
                    <!-- ============================================================= -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,12">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="LIVE TIME DELTA"
                                       Style="{StaticResource TelemetryLabelText}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4" />

                            <!-- Big Bold Delta Time Readout (e.g. +0.000s or -0.185s) -->
                            <TextBlock Text="{Binding DeltaDisplayString}"
                                       Style="{StaticResource DynamicDeltaStyle}"
                                       Margin="0,2,0,2" />

                            <Border Background="{StaticResource CanvasBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Padding="10,2"
                                    HorizontalAlignment="Center"
                                    Margin="0,4,0,0">
                                <TextBlock Text="{Binding DeltaStatusString}"
                                           FontFamily="{StaticResource TelemetryNumberFontFamily}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ForegroundHighlightBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ============================================================= -->
                    <!-- SECTION 2: TELEMETRY NUMERICAL CHANNELS                       -->
                    <!-- ============================================================= -->
                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Distance -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,4">
                                <TextBlock Text="DISTANCE" Style="{StaticResource TelemetryLabelText}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CurrentDistanceMeters, StringFormat={}{0:F0}}"
                                               Style="{StaticResource TelemetryValueText}" />
                                    <TextBlock Text=" m" Style="{StaticResource TelemetryLabelText}" VerticalAlignment="Bottom" Margin="2,0,0,1" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Gear & RPM -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,4">
                                <TextBlock Text="GEAR / RPM" Style="{StaticResource TelemetryLabelText}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CurrentGear}"
                                               Style="{StaticResource TelemetryValueText}" />
                                    <TextBlock Text=" / " Style="{StaticResource TelemetryLabelText}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentRpm}"
                                               Style="{StaticResource TelemetryValueText}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Sim Speed -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,4">
                                <TextBlock Text="LIVE SPEED" Style="{StaticResource TelemetryLabelText}" Foreground="{StaticResource LiveTraceBrush}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CurrentSimSpeedKmh, StringFormat={}{0:F1}}"
                                               Style="{StaticResource TelemetryValueText}"
                                               Foreground="{StaticResource LiveTraceBrush}" />
                                    <TextBlock Text=" km/h" Style="{StaticResource TelemetryLabelText}" VerticalAlignment="Bottom" Margin="2,0,0,1" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Ref Speed -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,4">
                                <TextBlock Text="REF SPEED" Style="{StaticResource TelemetryLabelText}" Foreground="{StaticResource ReferenceTraceBrush}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CurrentRefSpeedKmh, StringFormat={}{0:F1}}"
                                               Style="{StaticResource TelemetryValueText}"
                                               Foreground="{StaticResource ReferenceTraceBrush}" />
                                    <TextBlock Text=" km/h" Style="{StaticResource TelemetryLabelText}" VerticalAlignment="Bottom" Margin="2,0,0,1" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Speed Delta -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,4">
                                <TextBlock Text="SPEED DELTA" Style="{StaticResource TelemetryLabelText}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SpeedDeltaKmh, StringFormat={}{0:+0.0;-0.0;0.0}}"
                                               Style="{StaticResource SpeedDeltaStyle}" />
                                    <TextBlock Text=" km/h" Style="{StaticResource TelemetryLabelText}" VerticalAlignment="Bottom" Margin="2,0,0,1" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Lap Length Progress -->
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,4">
                                <TextBlock Text="LAP LENGTH" Style="{StaticResource TelemetryLabelText}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ReferenceTrackLengthMeters}"
                                               Style="{StaticResource TelemetryValueText}" />
                                    <TextBlock Text=" m" Style="{StaticResource TelemetryLabelText}" VerticalAlignment="Bottom" Margin="2,0,0,1" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Sim Elapsed Lap Time -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,4">
                                <TextBlock Text="SIM TIME" Style="{StaticResource TelemetryLabelText}" />
                                <TextBlock Text="{Binding CurrentSimTimeSeconds, StringFormat={}{0:F3}s}"
                                           Style="{StaticResource TelemetryValueText}" />
                            </StackPanel>

                            <!-- Ref Elapsed Lap Time -->
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,4">
                                <TextBlock Text="REF TIME" Style="{StaticResource TelemetryLabelText}" />
                                <TextBlock Text="{Binding CurrentRefTimeSeconds, StringFormat={}{0:F3}s}"
                                           Style="{StaticResource TelemetryValueText}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ============================================================= -->
                    <!-- SECTION 3: DRIVER INPUT GAUGES (Throttle & Brake)             -->
                    <!-- ============================================================= -->
                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="PEDAL INPUTS" Style="{StaticResource TelemetryLabelText}" Margin="0,0,0,8" />

                            <!-- Throttle Bar -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="42" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="THROTTLE"
                                           Style="{StaticResource TelemetryLabelText}"
                                           VerticalAlignment="Center" />

                                <ProgressBar Grid.Column="1"
                                             Height="12"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding CurrentSimThrottlePercent, Mode=OneWay}"
                                             Background="{StaticResource GaugeTrackBrush}"
                                             Foreground="{StaticResource ThrottleBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             BorderThickness="1" />

                                <TextBlock Grid.Column="2"
                                           Text="{Binding CurrentSimThrottlePercent, StringFormat={}{0:F0}%}"
                                           Style="{StaticResource TelemetryValueText}"
                                           FontSize="11"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <!-- Brake Bar -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="42" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="BRAKE"
                                           Style="{StaticResource TelemetryLabelText}"
                                           VerticalAlignment="Center" />

                                <ProgressBar Grid.Column="1"
                                             Height="12"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding CurrentSimBrakePercent, Mode=OneWay}"
                                             Background="{StaticResource GaugeTrackBrush}"
                                             Foreground="{StaticResource BrakeBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             BorderThickness="1" />

                                <TextBlock Grid.Column="2"
                                           Text="{Binding CurrentSimBrakePercent, StringFormat={}{0:F0}%}"
                                           Style="{StaticResource TelemetryValueText}"
                                           FontSize="11"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ============================================================= -->
                    <!-- SECTION 4: SECTOR ANALYSIS BREAKDOWN                          -->
                    <!-- ============================================================= -->
                    <Border Grid.Row="3" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="TRACK SECTOR ANALYSIS" Style="{StaticResource TelemetryLabelText}" Margin="0,0,0,8" />

                            <!-- One card per sector of the selected Grand Prix (from its track.json).
                                 Active sector gets a highlighted border; the delta turns green/red once timed. -->
                            <ItemsControl ItemsSource="{Binding Sectors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="SectorCard"
                                                Background="{StaticResource CanvasBackgroundBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="0"
                                                Padding="8,6"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Title}"
                                                               Style="{StaticResource TelemetryLabelText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Title}" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource ForegroundMutedBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock x:Name="SectorDelta"
                                                               Text="{Binding DeltaString}"
                                                               Style="{StaticResource TelemetryValueText}"
                                                               Foreground="{StaticResource ForegroundMutedBrush}"
                                                               FontSize="11"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding ReferenceTimeString}"
                                                               FontFamily="{StaticResource TelemetryNumberFontFamily}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource ReferenceTraceBrush}"
                                                               HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="SectorCard" Property="BorderBrush" Value="{StaticResource LiveTraceBrush}" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasDelta}" Value="True" />
                                                    <Condition Binding="{Binding IsAhead}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="SectorDelta" Property="Foreground" Value="{StaticResource DeltaAheadBrush}" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasDelta}" Value="True" />
                                                    <Condition Binding="{Binding IsAhead}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="SectorDelta" Property="Foreground" Value="{StaticResource DeltaBehindBrush}" />
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="No sector data for this Grand Prix. Re-run extract_reference.py to generate its track.json."
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource ForegroundMutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSectors}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ============================================================= -->
                    <!-- SECTION 5: TRACK MAP (outline from track.json, hideable)      -->
                    <!-- ============================================================= -->
                    <Border Grid.Row="4"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="12,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TRACK MAP" Style="{StaticResource TelemetryLabelText}" VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Command="{Binding ToggleTrackMapCommand}"
                                        Padding="8,2"
                                        FontSize="10">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TracksideButton}">
                                            <Setter Property="Content" Value="HIDE" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTrackMapVisible}" Value="False">
                                                    <Setter Property="Content" Value="SHOW" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTrackMapVisible}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <!-- Display only: hit testing off so the mouse wheel scrolls the sidebar -->
                                <sp:WpfPlot x:Name="TrackMapPlot"
                                            Height="{Binding TrackMapHeight}"
                                            IsHitTestVisible="False">
                                    <sp:WpfPlot.Style>
                                        <Style TargetType="sp:WpfPlot">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasTrackMap}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </sp:WpfPlot.Style>
                                </sp:WpfPlot>

                                <TextBlock Text="No map data for this Grand Prix. Re-run extract_reference.py to add an outline to its track.json."
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource ForegroundMutedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasTrackMap}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 4: BOTTOM ENGINEERING STATUS BAR                                      -->
        <!-- ========================================================================= -->
        <Border Grid.Row="4"
                Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <!-- Ingestion Status Message -->
                    <ColumnDefinition Width="*" />
                    <!-- Diagnostic Ring Buffer Metrics -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Ingestion Engine / Clock Spec -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Message -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Style="{StaticResource TelemetryLabelText}"
                           Foreground="{StaticResource ForegroundPrimaryBrush}"
                           VerticalAlignment="Center" />

                <!-- Buffer Count -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="RING BUFFER: " Style="{StaticResource TelemetryLabelText}" />
                    <TextBlock Text="{Binding BufferCount}" Style="{StaticResource TelemetryValueText}" FontSize="11" />
                    <TextBlock Text="/" Style="{StaticResource TelemetryLabelText}" />
                    <TextBlock Text="{Binding BufferCapacity}" Style="{StaticResource TelemetryValueText}" FontSize="11" />
                    <TextBlock Text=" (0 GC Allocations)" Style="{StaticResource TelemetryLabelText}" Margin="4,0,0,0" />
                </StackPanel>

                <!-- Ingestion Specification -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SOURCE: " Style="{StaticResource TelemetryLabelText}" />
                    <TextBlock Text="{Binding DataSource, StringFormat={}{0} | CLOCK: 60Hz}"
                               FontFamily="{StaticResource TelemetryNumberFontFamily}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ForegroundMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
