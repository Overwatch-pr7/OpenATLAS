<Window x:Class="OpenATLAS.Workbench.ImportLapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Lap"
        Width="640" Height="600"
        MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource PanelBackgroundBrush}"
        Foreground="{StaticResource ForegroundPrimaryBrush}"
        FontFamily="{StaticResource SystemFontFamily}">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource TelemetryLabelText}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="MonoBlock" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource TelemetryNumberFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- title -->
            <RowDefinition Height="Auto" />  <!-- file -->
            <RowDefinition Height="Auto" />  <!-- error -->
            <RowDefinition Height="*" />     <!-- detected / warnings -->
            <RowDefinition Height="Auto" />  <!-- lap, grand prix, name -->
            <RowDefinition Height="Auto" />  <!-- buttons -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="IMPORT LAP" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ForegroundHighlightBrush}" />
            <TextBlock Text="Bring in a lap from a telemetry log (CSV) so it can be compared as Racer 1 or Racer 2."
                       Style="{StaticResource TelemetryLabelText}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- FILE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="FILE" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Column="1" Style="{StaticResource TracksideTextBox}" Text="{Binding FilePath, Mode=OneWay}" IsReadOnly="True" />
            <Button Grid.Column="2" Content="BROWSE..." Style="{StaticResource TracksideButton}" Margin="6,0,0,0" Click="OnBrowse" />
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="{Binding Error}"
                   Style="{StaticResource MonoBlock}"
                   Foreground="{StaticResource DeltaBehindBrush}"
                   Margin="90,6,0,0" />

        <!-- DETECTED COLUMNS / WARNINGS, or the format description before a file is chosen -->
        <Border Grid.Row="3"
                Background="{StaticResource CanvasBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Padding="12,10"
                Margin="0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <!-- Before loading: what the file should look like -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="FILE FORMAT" Style="{StaticResource TelemetryLabelText}" Margin="0,0,0,6" />
                        <TextBlock x:Name="FormatText" Style="{StaticResource MonoBlock}" Foreground="{StaticResource ForegroundPrimaryBrush}" />
                    </StackPanel>

                    <!-- After loading: what was found in it -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <TextBlock Text="DETECTED COLUMNS" Style="{StaticResource TelemetryLabelText}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding DetectedColumns}" Style="{StaticResource MonoBlock}" Foreground="{StaticResource ForegroundHighlightBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="NOTES" Style="{StaticResource TelemetryLabelText}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Warnings}" Style="{StaticResource MonoBlock}" Foreground="{StaticResource StatusStandbyBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- LAP / GRAND PRIX / NAME -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="LAP" Style="{StaticResource FieldLabel}" />
            <ComboBox Grid.Row="0" Grid.Column="1"
                      Style="{StaticResource TracksideComboBox}"
                      ItemsSource="{Binding Laps}"
                      SelectedItem="{Binding SelectedLap}"
                      DisplayMemberPath="Label"
                      IsEnabled="{Binding IsLoaded}"
                      ToolTip="The fastest complete lap is chosen by default" />

            <TextBlock Grid.Row="1" Text="GRAND PRIX" Style="{StaticResource FieldLabel}" Margin="0,8,12,0" />
            <ComboBox Grid.Row="1" Grid.Column="1"
                      Style="{StaticResource TracksideComboBox}"
                      Margin="0,8,0,0"
                      ItemsSource="{Binding GrandPrixOptions}"
                      SelectedItem="{Binding SelectedGrandPrix}"
                      ToolTip="The circuit this lap was driven on" />

            <TextBlock Grid.Row="2" Text="NAME" Style="{StaticResource FieldLabel}" Margin="0,8,12,0" />
            <TextBox Grid.Row="2" Grid.Column="1"
                     Style="{StaticResource TracksideTextBox}"
                     Margin="0,8,0,0"
                     Text="{Binding LapName, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Shown in the Racer 1 / Racer 2 lap lists" />
        </Grid>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="CANCEL" Style="{StaticResource TracksideButton}" IsCancel="True" Margin="0,0,6,0" />
            <Button Content="IMPORT"
                    Style="{StaticResource TracksidePrimaryButton}"
                    IsDefault="True"
                    IsEnabled="{Binding CanImport}"
                    Click="OnImport" />
        </StackPanel>
    </Grid>
</Window>
